# API base URL. Defaults to https://api.plateit.co.uk when omitted or blank.
# Use the Plateit URL for direct access, or a proxy base such as /api or
# https://proxy.example.com/api. Paths such as /v3/orders are appended.
# Direct access requires the API to allow this portal origin through CORS.
VITE_API_URL=https://api.plateit.co.uk

# Optional company ID used only to redirect visitors from / to /c<ID>/status.
# Use a positive integer matching your Plateit company ID.
# Omit or leave blank to show the not-found page at /. Company-scoped links
# such as /c123/status still work and select their own company configuration.
VITE_COMPANY_ID=1

# Optional upload proxy endpoint, independent of VITE_API_URL.
# Omit or leave blank for direct PUT uploads to the signed storage URL.
# Set to /uploads or an absolute endpoint URL to send uploads via the
# separate proxy application. Direct uploads require storage CORS access;
# a cross-origin proxy must allow this portal origin in its own CORS policy.
VITE_UPLOAD_PROXY_URL=

# Optional crawler opt-out. Set true to generate robots.txt with Disallow: /
# and an HTML noindex,nofollow meta tag. Defaults to false when omitted.
# This is advisory, not access control. Rebuild and redeploy after changing it.
VITE_BLOCK_ROBOTS=false
